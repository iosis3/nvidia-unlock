+    /* Normal path */
     NV_FOR_EACH_DMA_SUBMAP(dma_map, submap, i)
     {
         for_each_sg(submap->sgt.sgl, sg, submap->sg_map_count, j)
         {
+            NvU64 sg_addr, sg_off, sg_len, k;
+
             /*
