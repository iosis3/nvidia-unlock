 )
 {
@@ -489,6 +555,7 @@ static NV_STATUS NV_API_CALL nv_dma_map_pages(
     dma_map->page_count = page_count;
     dma_map->contiguous = contig;
     dma_map->cache_type = cache_type;
+    dma_map->page_granularity = page_granularity;
 
