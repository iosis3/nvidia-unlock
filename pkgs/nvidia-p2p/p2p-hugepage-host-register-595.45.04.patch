+
+    if (compound_order > 0)
+        effective_count = page_count >> compound_order;
+    else
+        effective_count = page_count;
+
+    at = nvos_create_alloc(nvl->dev, effective_count);
 
     if (at == NULL)
     {
@@ -3481,9 +3491,10 @@ NV_STATUS NV_API_CALL nv_register_user_pages(
     if (unencrypted)
