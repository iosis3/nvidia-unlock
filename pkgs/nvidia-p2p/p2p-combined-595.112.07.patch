From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: aikitoria <151776613+aikitoria@users.noreply.github.com>
Date: Sun, 5 Apr 2026 06:36:23 +0200
Subject: [PATCH] Combined P2P mod based on the one by geohot, 5090 support by
 nimlgen, NVLink support by valdemardi

---
 kernel-open/nvidia-uvm/uvm_gpu.h              |  7 +++
 kernel-open/nvidia/nv-reg.h                   |  2 +-
 src/nvidia/generated/g_kern_bus_nvoc.c        | 10 ++--
 src/nvidia/src/kernel/gpu/bif/kernel_bif.c    |  6 +--
 .../gpu/bus/arch/pascal/kern_bus_gp100.c      | 10 ++++
 src/nvidia/src/kernel/mem_mgr/io_vaspace.c    | 21 ++++----
 src/nvidia/src/kernel/rmapi/nv_gpu_ops.c      | 48 +++++++++++++++----
 7 files changed, 76 insertions(+), 28 deletions(-)

diff --git a/kernel-open/nvidia-uvm/uvm_gpu.h b/kernel-open/nvidia-uvm/uvm_gpu.h
index 45b2ff7..6ec8417 100644
--- a/kernel-open/nvidia-uvm/uvm_gpu.h
+++ b/kernel-open/nvidia-uvm/uvm_gpu.h
@@ -1824,6 +1824,13 @@ NvU64 uvm_parent_gpu_canonical_address(uvm_parent_gpu_t *parent_gpu, NvU64 addr)
 
 static bool uvm_parent_gpu_is_coherent(const uvm_parent_gpu_t *parent_gpu)
 {
+    // Blackwell+ consumer GPUs (e.g. 5090) use BAR1 P2P via the SYS_COH
+    // aperture rewrite in nvGpuOpsBuildExternalAllocPtes. UVM's P2P
+    // registration path must take the coherent route to match, otherwise
+    // the ZONE_DEVICE peer DMA setup conflicts with BAR1-as-sysmem PTEs.
+    if (parent_gpu->rm_info.gpuArch >= NV2080_CTRL_MC_ARCH_INFO_ARCHITECTURE_GB100)
+        return true;
+
     return parent_gpu->system_bus.memory_window_end > parent_gpu->system_bus.memory_window_start;
 }
 
